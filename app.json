{
  "expo": {
    "name": "mi-purchase-app",
    "slug": "mi-purchase-app",
    "version": "1.0.0",
    "entryPoint": "./src/app/App",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5F7FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mipurchase.app"
    },
    "android": {
      "package": "com.mipurchase.app"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
